# Copie para .env e preencha (NUNCA commite a chave real).
#   cp .env.example .env

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcionais
CLAUDE_MODEL=claude-opus-4-8
PORT=3000

# ── MCP Server remoto (mcp/http.js) ──
# URL pública do servidor (usada nos metadados de OAuth). Em produção,
# aponte para o host HTTPS onde o servidor está publicado.
MCP_PUBLIC_URL=http://localhost:3000
# Defina como "false" apenas em dev para testar as tools sem OAuth.
MCP_REQUIRE_AUTH=true

# ── IdP externo / BROKER OAuth (opcional) ──
# Preencha para delegar login+consentimento a um IdP real (ex.: Bradesco).
# Sem estas variáveis, o /authorize usa a tela mock de demonstração.
# Registre o SEU app no portal do Bradesco/Axway e cadastre o redirect_uri
# como  <MCP_PUBLIC_URL>/callback  (ex.: https://seu-host/callback).
# IDP_AUTHORIZE_URL=https://.../oauth2/authorize
# IDP_TOKEN_URL=https://.../oauth2/token
# IDP_CLIENT_ID=seu-client-id-registrado
# IDP_CLIENT_SECRET=seu-client-secret        # se o IdP exigir (client confidencial)
# IDP_SCOPE=openid profile contas.saldo.read
